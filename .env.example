# Server-only values. Do not prefix these with VITE_ or expose the service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
SESSION_SECRET=replace-with-a-long-random-secret
# Optional separate encryption secret for saved GOG tokens. Keep stable between restarts.
# Without this, GOG token encryption derives from SESSION_SECRET. Changing it requires reconnecting GOG.
# GOG_TOKEN_SECRET=replace-with-a-long-random-secret
# Optional GOG desktop-client overrides; the Heroic-compatible public client is the default.
# GOG_CLIENT_ID=your-client-id
# GOG_CLIENT_SECRET=your-client-secret
STEAM_API_KEY=your-steam-web-api-key
# Optional. Enables classic game achievement progress from RetroAchievements / RetroArch.
RETROACHIEVEMENTS_API_KEY=your-retroachievements-web-api-key
RETROACHIEVEMENTS_USERNAME=your-retroachievements-username
# Optional. Enables cross-platform RAWG search, game descriptions, ratings, Metacritic scores, and screenshots.
RAWG_API_KEY=your-rawg-api-key
# Optional. Enables SteamGridDB grids, heroes, and logos in game detail views.
STEAMGRIDDB_API_KEY=your-steamgriddb-api-key

# Optional when deployed behind a proxy/custom domain.
# APP_URL=https://your-retrovault-domain.example
# NODE_ENV=production
